{
  "name": "gripterm",
  "displayName": "Gripterm",
  "description": "Observe, name and restore your Claude Code terminals.",
  "version": "0.0.1",
  "publisher": "gripterm-placeholder",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Terminals are observed and restored, but no workflow script from the folder is executed until the folder is trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gripterm.newTerminal",
        "title": "Gripterm: New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "gripterm.closeTerminal",
        "title": "Gripterm: Close Terminal",
        "icon": "$(close)"
      },
      {
        "command": "gripterm.deleteTerminal",
        "title": "Gripterm: Delete Record",
        "icon": "$(trash)"
      },
      {
        "command": "gripterm.renameTerminal",
        "title": "Gripterm: Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "gripterm.setTask",
        "title": "Gripterm: Set Task",
        "icon": "$(target)"
      },
      {
        "command": "gripterm.addNote",
        "title": "Gripterm: Add Note",
        "icon": "$(note)"
      },
      {
        "command": "gripterm.editTags",
        "title": "Gripterm: Edit Tags",
        "icon": "$(tag)"
      },
      {
        "command": "gripterm.setColor",
        "title": "Gripterm: Set Colour",
        "icon": "$(symbol-color)"
      },
      {
        "command": "gripterm.showLogs",
        "title": "Gripterm: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "gripterm.focusTerminal",
        "title": "Gripterm: Show Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "gripterm.showRecord",
        "title": "Gripterm: Show Record",
        "icon": "$(list-selection)"
      },
      {
        "command": "gripterm.resumeTerminal",
        "title": "Gripterm: Resume Terminal",
        "icon": "$(debug-start)"
      },
      {
        "command": "gripterm.startOver",
        "title": "Gripterm: Start Over",
        "icon": "$(debug-restart)"
      },
      {
        "command": "gripterm.adoptTerminal",
        "title": "Gripterm: Adopt Terminal",
        "icon": "$(sign-in)"
      },
      {
        "command": "gripterm.cleanUpStorage",
        "title": "Gripterm: Clean Up Storage",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gripterm.newTerminal",
          "when": "view == gripterm.terminals",
          "group": "navigation"
        },
        {
          "command": "gripterm.cleanUpStorage",
          "when": "view == gripterm.terminals",
          "group": "9_store@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gripterm.focusTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "inline"
        },
        {
          "command": "gripterm.renameTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@1"
        },
        {
          "command": "gripterm.renameTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@1"
        },
        {
          "command": "gripterm.setTask",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@2"
        },
        {
          "command": "gripterm.setTask",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@2"
        },
        {
          "command": "gripterm.addNote",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@3"
        },
        {
          "command": "gripterm.addNote",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@3"
        },
        {
          "command": "gripterm.editTags",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@4"
        },
        {
          "command": "gripterm.editTags",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@4"
        },
        {
          "command": "gripterm.setColor",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@5"
        },
        {
          "command": "gripterm.setColor",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@5"
        },
        {
          "command": "gripterm.closeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.resumeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "inline"
        },
        {
          "command": "gripterm.resumeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@0"
        },
        {
          "command": "gripterm.showLogs",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.startOver",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@2"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@3"
        },
        {
          "command": "gripterm.adoptTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "inline"
        },
        {
          "command": "gripterm.adoptTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "2_act@2"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.abandoned",
          "group": "2_act@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gripterm.focusTerminal",
          "when": "false"
        },
        {
          "command": "gripterm.showRecord",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gripterm.terminals",
          "name": "Claude Code Terminals",
          "contextualTitle": "Gripterm"
        }
      ]
    },
    "configuration": {
      "title": "Gripterm",
      "properties": {
        "gripterm.storage.path": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Where Gripterm keeps its store: the records of every terminal, their event journals and the presence file of each window. Empty means `~/.gripterm`. A relative path is refused and the default used instead. Takes effect when the window reloads — every window on the machine must point at the same store to see each other."
        },
        "gripterm.reconcile.intervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "scope": "window",
          "markdownDescription": "How often Gripterm checks the machine for terminals whose process is gone and for windows that closed without saying so. Each check runs `claude agents --json` once, so raising it costs freshness and lowers the load. Values outside 5–3600 seconds are refused and the default used instead. Takes effect when the window reloads."
        },
        "gripterm.notify.toastStates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "waiting_permission",
              "waiting_input",
              "launch_failed",
              "resume_failed",
              "turn_failed",
              "ended",
              "orphaned",
              "degraded",
              "idle",
              "working",
              "launching"
            ]
          },
          "default": [
            "waiting_permission",
            "launch_failed",
            "resume_failed"
          ],
          "markdownDescription": "States that raise a notification when a terminal ENTERS them. An empty list turns notifications off."
        },
        "gripterm.launch.mode": {
          "type": "string",
          "enum": [
            "process",
            "shell"
          ],
          "enumDescriptions": [
            "Claude Code is the terminal's own process. No shell runs, so no shell profile is applied.",
            "The command is typed into your configured shell. Use this if `claude` is only on your PATH after your shell profile has run."
          ],
          "default": "process",
          "markdownDescription": "How a Gripterm terminal is started."
        },
        "gripterm.launch.location": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "In the editor area, as a tab. The panel and its list of terminals stay out of the way, and the tab carries the terminal's Gripterm name.",
            "In the terminal panel, alongside your ordinary terminals."
          ],
          "default": "editor",
          "markdownDescription": "Where a Gripterm terminal is opened."
        },
        "gripterm.journal.includeContent": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Write the texts of prompts, assistant answers and tool arguments into the event journal on disk. Off by default: with it off, only structural fields — the event name, the session, the tool name — are kept, and the names of the fields that were left out. Takes effect when the window reloads."
        },
        "gripterm.journal.retentionDays": {
          "type": "number",
          "minimum": 0,
          "default": 14,
          "scope": "window",
          "markdownDescription": "Days of event history kept for each terminal, beside the day being written. Older journal files are deleted. Takes effect when the window reloads."
        },
        "gripterm.journal.maxSizeMb": {
          "type": "number",
          "minimum": 0,
          "default": 64,
          "scope": "window",
          "markdownDescription": "Size cap for one terminal's event journal, in megabytes. The oldest whole files are deleted first; the day being written is never trimmed. Takes effect when the window reloads."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "bundle": "node esbuild.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@gripterm/core": "workspace:*"
  }
}
