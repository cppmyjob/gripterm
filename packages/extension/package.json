{
  "name": "gripterm",
  "displayName": "Gripterm",
  "description": "Observe, name and restore your Claude Code terminals.",
  "version": "0.0.1",
  "publisher": "gripterm-placeholder",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Terminals are observed and restored, but no workflow script from the folder is executed until the folder is trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gripterm.newTerminal",
        "title": "Gripterm: New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "gripterm.closeTerminal",
        "title": "Gripterm: Close Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "gripterm.showLogs",
        "title": "Gripterm: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "gripterm.focusTerminal",
        "title": "Gripterm: Show Terminal",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gripterm.newTerminal",
          "when": "view == gripterm.terminals",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gripterm.focusTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "inline"
        },
        {
          "command": "gripterm.closeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_act"
        },
        {
          "command": "gripterm.showLogs",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_act"
        }
      ],
      "commandPalette": [
        {
          "command": "gripterm.focusTerminal",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gripterm.terminals",
          "name": "Claude Code Terminals",
          "contextualTitle": "Gripterm"
        }
      ]
    },
    "configuration": {
      "title": "Gripterm",
      "properties": {
        "gripterm.notify.toastStates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "waiting_permission",
              "waiting_input",
              "launch_failed",
              "resume_failed",
              "turn_failed",
              "ended",
              "orphaned",
              "degraded",
              "idle",
              "working",
              "launching"
            ]
          },
          "default": [
            "waiting_permission",
            "launch_failed"
          ],
          "markdownDescription": "States that raise a notification when a terminal ENTERS them. An empty list turns notifications off."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "bundle": "node esbuild.js"
  },
  "dependencies": {
    "@gripterm/core": "workspace:*"
  }
}
