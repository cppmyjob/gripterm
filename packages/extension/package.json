{
  "name": "gripterm",
  "displayName": "Gripterm",
  "description": "Observe, name and restore your Claude Code terminals.",
  "version": "0.0.1",
  "publisher": "gripterm-placeholder",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Terminals are observed and restored, but no workflow script from the folder is executed until the folder is trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gripterm.newTerminal",
        "title": "Gripterm: New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "gripterm.closeTerminal",
        "title": "Gripterm: Close Terminal",
        "icon": "$(close)"
      },
      {
        "command": "gripterm.deleteTerminal",
        "title": "Gripterm: Delete Record",
        "icon": "$(trash)"
      },
      {
        "command": "gripterm.renameTerminal",
        "title": "Gripterm: Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "gripterm.setTask",
        "title": "Gripterm: Set Task",
        "icon": "$(target)"
      },
      {
        "command": "gripterm.addNote",
        "title": "Gripterm: Add Note",
        "icon": "$(note)"
      },
      {
        "command": "gripterm.editTags",
        "title": "Gripterm: Edit Tags",
        "icon": "$(tag)"
      },
      {
        "command": "gripterm.setColor",
        "title": "Gripterm: Set Colour",
        "icon": "$(symbol-color)"
      },
      {
        "command": "gripterm.showLogs",
        "title": "Gripterm: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "gripterm.focusTerminal",
        "title": "Gripterm: Show Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "gripterm.maximizeTerminals",
        "title": "Gripterm: Maximise the Terminals",
        "icon": "$(chevron-up)"
      },
      {
        "command": "gripterm.restoreTerminals",
        "title": "Gripterm: Restore the Terminals",
        "icon": "$(chevron-down)"
      },
      {
        "command": "gripterm.showRecord",
        "title": "Gripterm: Show Record",
        "icon": "$(list-selection)"
      },
      {
        "command": "gripterm.resumeTerminal",
        "title": "Gripterm: Resume Terminal",
        "icon": "$(debug-start)"
      },
      {
        "command": "gripterm.startOver",
        "title": "Gripterm: Start Over",
        "icon": "$(debug-restart)"
      },
      {
        "command": "gripterm.adoptTerminal",
        "title": "Gripterm: Adopt Terminal",
        "icon": "$(sign-in)"
      },
      {
        "command": "gripterm.cleanUpStorage",
        "title": "Gripterm: Clean Up Storage",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+b",
        "key": "ctrl+b",
        "when": "gripterm.terminalFocused"
      },
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+j",
        "key": "ctrl+j",
        "when": "gripterm.terminalFocused"
      },
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+p",
        "key": "ctrl+p",
        "when": "gripterm.terminalFocused"
      },
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+r",
        "key": "ctrl+r",
        "when": "gripterm.terminalFocused"
      },
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+w",
        "key": "ctrl+w",
        "when": "gripterm.terminalFocused"
      },
      {
        "command": "gripterm.terminalKey",
        "args": "ctrl+z",
        "key": "ctrl+z",
        "when": "gripterm.terminalFocused"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gripterm.newTerminal",
          "when": "view == gripterm.terminals",
          "group": "navigation"
        },
        {
          "command": "gripterm.cleanUpStorage",
          "when": "view == gripterm.terminals",
          "group": "9_store@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gripterm.focusTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "inline"
        },
        {
          "command": "gripterm.renameTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@1"
        },
        {
          "command": "gripterm.renameTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@1"
        },
        {
          "command": "gripterm.setTask",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@2"
        },
        {
          "command": "gripterm.setTask",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@2"
        },
        {
          "command": "gripterm.addNote",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@3"
        },
        {
          "command": "gripterm.addNote",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@3"
        },
        {
          "command": "gripterm.editTags",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@4"
        },
        {
          "command": "gripterm.editTags",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@4"
        },
        {
          "command": "gripterm.setColor",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "1_edit@5"
        },
        {
          "command": "gripterm.setColor",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "1_edit@5"
        },
        {
          "command": "gripterm.closeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.live",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.resumeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "inline"
        },
        {
          "command": "gripterm.resumeTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@0"
        },
        {
          "command": "gripterm.showLogs",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.startOver",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@2"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.over",
          "group": "2_act@3"
        },
        {
          "command": "gripterm.adoptTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "inline@1"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "inline@2"
        },
        {
          "command": "gripterm.adoptTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "2_act@1"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.adoptable",
          "group": "2_act@2"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.abandoned",
          "group": "inline"
        },
        {
          "command": "gripterm.deleteTerminal",
          "when": "view == gripterm.terminals && viewItem == gripterm.terminal.abandoned",
          "group": "2_act@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gripterm.focusTerminal",
          "when": "false"
        },
        {
          "command": "gripterm.showRecord",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "gripterm.maximizeTerminals",
          "when": "activeEditor == 'terminalEditor' && editorPartMultipleEditorGroups && !editorPartMaximizedEditorGroup",
          "group": "navigation@1"
        },
        {
          "command": "gripterm.restoreTerminals",
          "when": "activeEditor == 'terminalEditor' && editorPartMaximizedEditorGroup",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "griptermPanel",
          "title": "Gripterm",
          "icon": "media/panel.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gripterm.terminals",
          "name": "Claude Code Terminals",
          "contextualTitle": "Gripterm"
        }
      ],
      "griptermPanel": [
        {
          "id": "gripterm.workbench",
          "name": "Agents",
          "type": "webview",
          "contextualTitle": "Gripterm"
        }
      ]
    },
    "configuration": {
      "title": "Gripterm",
      "properties": {
        "gripterm.storage.path": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Where Gripterm keeps its store: the records of every terminal, their event journals and the presence file of each window. Empty means `~/.gripterm`. A relative path is refused and the default used instead. Takes effect when the window reloads — every window on the machine must point at the same store to see each other."
        },
        "gripterm.reconcile.intervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "scope": "window",
          "markdownDescription": "How often Gripterm checks the machine for terminals whose process is gone and for windows that closed without saying so. Each check runs `claude agents --json` once, so raising it costs freshness and lowers the load. Values outside 5–3600 seconds are refused and the default used instead. Takes effect when the window reloads."
        },
        "gripterm.notify.toastStates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "waiting_permission",
              "waiting_input",
              "launch_failed",
              "resume_failed",
              "turn_failed",
              "ended",
              "orphaned",
              "degraded",
              "idle",
              "working",
              "launching"
            ]
          },
          "default": [
            "waiting_permission",
            "launch_failed",
            "resume_failed"
          ],
          "markdownDescription": "States that raise a notification when a terminal ENTERS them. An empty list turns notifications off. Takes effect when the window reloads."
        },
        "gripterm.launch.mode": {
          "type": "string",
          "enum": [
            "process",
            "shell"
          ],
          "enumDescriptions": [
            "Claude Code is the terminal's own process. No shell runs, so no shell profile is applied.",
            "The command is typed into your configured shell. Use this if `claude` is only on your PATH after your shell profile has run. Gripterm cannot do this in a terminal of its own: with gripterm.terminal.engine: own, this mode falls back to the editor and says so in the log."
          ],
          "default": "process",
          "markdownDescription": "How a Gripterm terminal is started. Takes effect when the window reloads."
        },
        "gripterm.launch.location": {
          "type": "string",
          "enum": [
            "group",
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "In a group of the editor area that belongs to your agents: a strip below the editors, holding their tabs and nothing else. It appears with the first terminal and goes with the last.",
            "In the editor area, as a tab among your own editors. The panel and its list of terminals stay out of the way, and the tab carries the terminal's Gripterm name.",
            "In the terminal panel, alongside your ordinary terminals."
          ],
          "default": "group",
          "markdownDescription": "Where a Gripterm terminal is opened. Not used by `gripterm.terminal.engine: own`, which has one place of its own: the Gripterm panel. Takes effect when the window reloads."
        },
        "gripterm.terminal.engine": {
          "type": "string",
          "enum": [
            "editor",
            "own"
          ],
          "enumDescriptions": [
            "The editor makes the terminal. Everything you can see and do with a terminal today comes from this: the tab, the scrollback, the selection, the search.",
            "Gripterm makes the terminal itself, so it can see the bytes going through it. The agent runs in the Gripterm panel: its output, your typing and the size of the panel all reach it, several agents share a strip of tabs above it, and what is known about the one on screen is shown beside it. Windows and macOS only: on Linux there is no prebuilt addon to load, so the editor makes the terminal instead and the log says so. Not available with gripterm.launch.mode: shell, which falls back to the editor the same way. gripterm.launch.location does not apply to this engine. An agent here does not get everything other extensions add to the terminals the editor makes: the git askpass of the editor is one it loses. The channel to the Claude Code extension is NOT lost -- the CLI finds it without the port -- but it is off unless you turn on gripterm.terminal.ideChannel, and that setting says what it costs."
          ],
          "default": "editor",
          "markdownDescription": "Which engine opens a Gripterm terminal. Takes effect when the window reloads."
        },
        "gripterm.terminal.ideChannel": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Let an agent in a Gripterm terminal reach the Claude Code extension of this editor, so that it is handed the file you have open and the text you have selected. Off by default, because it is paid for: the editor's own terminal takes the focus away from the Gripterm panel every time you send a prompt, and only one agent can be connected at a time however many are running. Applies to `gripterm.terminal.engine: own` only — under the editor engine the extension does this itself. Takes effect when the window reloads."
        },
        "gripterm.journal.includeContent": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Write the texts of prompts, assistant answers and tool arguments into the event journal on disk. Off by default: with it off, only structural fields — the event name, the session, the tool name — are kept, and the names of the fields that were left out. Takes effect when the window reloads."
        },
        "gripterm.journal.retentionDays": {
          "type": "number",
          "minimum": 0,
          "default": 14,
          "scope": "window",
          "markdownDescription": "Days of event history kept for each terminal, beside the day being written. Older journal files are deleted. Takes effect when the window reloads."
        },
        "gripterm.journal.maxSizeMb": {
          "type": "number",
          "minimum": 0,
          "default": 64,
          "scope": "window",
          "markdownDescription": "Size cap for one terminal's event journal, in megabytes. The oldest whole files are deleted first; the day being written is never trimmed. Takes effect when the window reloads."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "bundle": "node esbuild.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@gripterm/core": "workspace:*",
    "@gripterm/webview": "workspace:*",
    "node-pty": "1.1.0"
  }
}
